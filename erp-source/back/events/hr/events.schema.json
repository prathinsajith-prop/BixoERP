{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp.events.hr",
  "title": "HR Domain Events",
  "description": "Kafka event contracts for hr-svc",
  "definitions": {
    "hr.employee.onboarded": {
      "type": "object",
      "required": ["employee_id", "employee_number", "first_name", "last_name", "department_id", "position_id"],
      "properties": {
        "employee_id": { "type": "string", "format": "uuid" },
        "employee_number": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "department_id": { "type": "string", "format": "uuid" },
        "position_id": { "type": "string", "format": "uuid" },
        "hire_date": { "type": "string", "format": "date" },
        "manager_id": { "type": "string", "format": "uuid" }
      }
    },
    "hr.employee.terminated": {
      "type": "object",
      "required": ["employee_id", "employee_number", "termination_date", "reason"],
      "properties": {
        "employee_id": { "type": "string", "format": "uuid" },
        "employee_number": { "type": "string" },
        "termination_date": { "type": "string", "format": "date" },
        "reason": { "type": "string" },
        "last_working_day": { "type": "string", "format": "date" }
      }
    },
    "hr.employee.transferred": {
      "type": "object",
      "required": ["employee_id", "from_department_id", "to_department_id", "effective_date"],
      "properties": {
        "employee_id": { "type": "string", "format": "uuid" },
        "from_department_id": { "type": "string", "format": "uuid" },
        "to_department_id": { "type": "string", "format": "uuid" },
        "from_position_id": { "type": "string", "format": "uuid" },
        "to_position_id": { "type": "string", "format": "uuid" },
        "effective_date": { "type": "string", "format": "date" }
      }
    },
    "hr.payroll.processed": {
      "type": "object",
      "required": ["payroll_run_id", "period_start", "period_end", "total_gross", "total_net", "employee_count"],
      "properties": {
        "payroll_run_id": { "type": "string", "format": "uuid" },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "total_gross": { "type": "string" },
        "total_deductions": { "type": "string" },
        "total_net": { "type": "string" },
        "employee_count": { "type": "integer" },
        "currency": { "type": "string" }
      }
    },
    "hr.leave.requested": {
      "type": "object",
      "required": ["leave_request_id", "employee_id", "leave_type", "start_date", "end_date", "days"],
      "properties": {
        "leave_request_id": { "type": "string", "format": "uuid" },
        "employee_id": { "type": "string", "format": "uuid" },
        "leave_type": { "type": "string", "enum": ["ANNUAL", "SICK", "MATERNITY", "PATERNITY", "UNPAID", "BEREAVEMENT"] },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "days": { "type": "number" }
      }
    },
    "hr.leave.approved": {
      "type": "object",
      "required": ["leave_request_id", "employee_id", "approved_by"],
      "properties": {
        "leave_request_id": { "type": "string", "format": "uuid" },
        "employee_id": { "type": "string", "format": "uuid" },
        "approved_by": { "type": "string", "format": "uuid" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
