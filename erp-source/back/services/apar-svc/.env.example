# Application
PORT=3002
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp
DB_PASSWORD=erp_dev_password
DB_NAME=apar_db
DB_SCHEMA=public
DB_LOGGING=false

# Kafka
KAFKA_BROKERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# JWT (re-validated at service level)
JWT_SECRET=dev-secret-change-in-production
JWT_ISSUER=erp-gateway

# gRPC
GRPC_PORT=50052

# Observability
OTLP_ENDPOINT=http://localhost:4318
