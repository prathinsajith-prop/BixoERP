PORT=3005
GRPC_PORT=50055

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=inventory_user
DB_PASSWORD=inventory_pass
DB_NAME=inventory_db
DB_SSL_MODE=disable
DB_MAX_CONNS=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=inventory-svc
KAFKA_CLIENT_ID=inventory-svc

# JWT
JWT_SECRET=your-secret-key

# Logging
LOG_LEVEL=info
