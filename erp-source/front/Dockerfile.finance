FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/

RUN npm ci && npm install --no-save lightningcss-linux-arm64-musl lightningcss-linux-x64-musl @tailwindcss/oxide-linux-arm64-musl @tailwindcss/oxide-linux-x64-musl

ENV DOCKER_ENV=true
RUN npx turbo build --filter=@erp/finance-app

FROM node:20-alpine AS runner

RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001

WORKDIR /app

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/finance ./apps/finance
COPY --from=builder /app/packages ./packages

USER appuser
EXPOSE 4001

WORKDIR /app/apps/finance
CMD ["npx", "next", "start", "-p", "4001"]
