{
  "manifest_version": "1.0.0",

  "module": {
    "id": "apar_module",
    "name": "Accounts Payable & Receivable",
    "version": "1.0.0",
    "description": "Full AP/AR lifecycle — vendor and customer invoices, credit notes, payments, aging reports, and statement reconciliation.",
    "author": "Bixo",
    "license": "proprietary",
    "namespace": "erp.modules.apar"
  },

  "compatibility": {
    "core_min_version": "1.0.0",
    "core_max_version": "2.x",
    "api_version": "v1",
    "dependencies": [
      { "module": "core", "version": ">=1.0.0", "optional": false },
      { "module": "finance_module", "version": ">=1.0.0", "optional": false },
      { "module": "auth_module", "version": ">=1.0.0", "optional": false },
      {
        "module": "notifications_module",
        "version": ">=1.0.0",
        "optional": true
      }
    ]
  },

  "sync": {
    "strategy": "incremental",
    "direction": "bidirectional",
    "trigger": "event_driven",
    "polling_interval_seconds": 300,
    "retry_policy": {
      "max_attempts": 3,
      "backoff_strategy": "exponential",
      "initial_delay_ms": 1000
    },
    "conflict_resolution": "last_write_wins",
    "batch_size": 150
  },

  "ui": {
    "icon": "FileText",
    "color": "blue",
    "basePath": "/apar",
    "position": 2,
    "menu": [
      {
        "label": "Dashboard",
        "href": "/apar",
        "icon": "LayoutDashboard",
        "permission": "apar:dashboard.view",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 1
      },
      {
        "label": "Vendors",
        "href": "/apar/vendors",
        "icon": "Truck",
        "permission": "apar:vendor.read",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 2
      },
      {
        "label": "Customers",
        "href": "/apar/customers",
        "icon": "Users",
        "permission": "apar:customer.read",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 3
      },
      {
        "label": "Vendor Invoices",
        "href": "/apar/vendor-invoices",
        "icon": "FileInput",
        "permission": "apar:vendor_invoice.read",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 4
      },
      {
        "label": "Customer Invoices",
        "href": "/apar/customer-invoices",
        "icon": "FileOutput",
        "permission": "apar:customer_invoice.read",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 5
      },
      {
        "label": "Payments",
        "href": "/apar/payments",
        "icon": "Wallet",
        "permission": "apar:payment.read",
        "visibleTo": ["apar_admin", "apar_manager", "apar_officer"],
        "position": 6
      },
      {
        "label": "Credit Notes",
        "href": "/apar/credit-notes",
        "icon": "FileMinus",
        "permission": "apar:credit_note.read",
        "visibleTo": [
          "apar_admin",
          "apar_manager",
          "apar_officer",
          "apar_viewer"
        ],
        "position": 7
      },
      {
        "label": "Aging Reports",
        "href": "/apar/aging",
        "icon": "Clock",
        "permission": "apar:reports.view",
        "visibleTo": ["apar_admin", "apar_manager", "apar_viewer"],
        "position": 8
      },
      {
        "label": "Reports",
        "href": "/apar/reports",
        "icon": "BarChart3",
        "permission": "apar:reports.view",
        "visibleTo": ["apar_admin", "apar_manager", "apar_viewer"],
        "position": 9
      },
      {
        "label": "Settings",
        "href": "/apar/settings",
        "icon": "Settings",
        "permission": "apar:settings.manage",
        "visibleTo": ["apar_admin"],
        "position": 10
      }
    ],
    "widgets": [
      {
        "id": "apar_ap_outstanding",
        "label": "Outstanding Payables",
        "dashboard": true,
        "size": "medium"
      },
      {
        "id": "apar_ar_outstanding",
        "label": "Outstanding Receivables",
        "dashboard": true,
        "size": "medium"
      },
      {
        "id": "apar_overdue_invoices",
        "label": "Overdue Invoices",
        "dashboard": true,
        "size": "small"
      },
      {
        "id": "apar_payments_due",
        "label": "Upcoming Payments",
        "dashboard": true,
        "size": "small"
      },
      {
        "id": "apar_cashflow_forecast",
        "label": "Cash Flow Forecast",
        "dashboard": true,
        "size": "large"
      }
    ]
  },

  "ports": {
    "frontend": 4002,
    "backend": 3002
  },

  "tier": "standard",

  "roles": [
    {
      "id": "apar_admin",
      "name": "AP/AR Administrator",
      "description": "Full access to all AP/AR features",
      "scopes": [
        "apar:dashboard.view",
        "apar:vendor.read",
        "apar:vendor.create",
        "apar:vendor.update",
        "apar:vendor.delete",
        "apar:customer.read",
        "apar:customer.create",
        "apar:customer.update",
        "apar:customer.delete",
        "apar:vendor_invoice.read",
        "apar:vendor_invoice.create",
        "apar:vendor_invoice.update",
        "apar:vendor_invoice.delete",
        "apar:vendor_invoice.approve",
        "apar:customer_invoice.read",
        "apar:customer_invoice.create",
        "apar:customer_invoice.update",
        "apar:customer_invoice.delete",
        "apar:customer_invoice.send",
        "apar:payment.read",
        "apar:payment.create",
        "apar:payment.update",
        "apar:payment.delete",
        "apar:credit_note.read",
        "apar:credit_note.create",
        "apar:credit_note.update",
        "apar:reports.view",
        "apar:settings.manage",
        "apar:sync.pull",
        "apar:sync.push"
      ]
    },
    {
      "id": "apar_manager",
      "name": "AP/AR Manager",
      "description": "Manage invoices, payments, and approve transactions",
      "scopes": [
        "apar:dashboard.view",
        "apar:vendor.read",
        "apar:customer.read",
        "apar:vendor_invoice.read",
        "apar:vendor_invoice.create",
        "apar:vendor_invoice.update",
        "apar:vendor_invoice.approve",
        "apar:customer_invoice.read",
        "apar:customer_invoice.create",
        "apar:customer_invoice.update",
        "apar:customer_invoice.send",
        "apar:payment.read",
        "apar:payment.create",
        "apar:credit_note.read",
        "apar:credit_note.create",
        "apar:reports.view"
      ]
    },
    {
      "id": "apar_officer",
      "name": "AP/AR Officer",
      "description": "Create and manage invoices and payments",
      "scopes": [
        "apar:dashboard.view",
        "apar:vendor.read",
        "apar:customer.read",
        "apar:vendor_invoice.read",
        "apar:vendor_invoice.create",
        "apar:vendor_invoice.update",
        "apar:customer_invoice.read",
        "apar:customer_invoice.create",
        "apar:customer_invoice.update",
        "apar:payment.read",
        "apar:credit_note.read"
      ]
    },
    {
      "id": "apar_viewer",
      "name": "AP/AR Viewer",
      "description": "Read-only access to AP/AR data",
      "scopes": [
        "apar:dashboard.view",
        "apar:vendor.read",
        "apar:customer.read",
        "apar:vendor_invoice.read",
        "apar:customer_invoice.read",
        "apar:payment.read",
        "apar:credit_note.read",
        "apar:reports.view"
      ]
    }
  ],

  "permissions": [
    {
      "resource": "dashboard",
      "actions": [
        {
          "id": "apar:dashboard.view",
          "name": "View Dashboard",
          "description": "View AP/AR KPIs"
        }
      ]
    },
    {
      "resource": "vendor",
      "actions": [
        {
          "id": "apar:vendor.read",
          "name": "View Vendors",
          "description": "View vendor list and details"
        },
        {
          "id": "apar:vendor.create",
          "name": "Create Vendor",
          "description": "Add new vendors"
        },
        {
          "id": "apar:vendor.update",
          "name": "Update Vendor",
          "description": "Edit vendor details"
        },
        {
          "id": "apar:vendor.delete",
          "name": "Delete Vendor",
          "description": "Remove vendors"
        }
      ]
    },
    {
      "resource": "customer",
      "actions": [
        {
          "id": "apar:customer.read",
          "name": "View Customers",
          "description": "View customer list and details"
        },
        {
          "id": "apar:customer.create",
          "name": "Create Customer",
          "description": "Add new customers"
        },
        {
          "id": "apar:customer.update",
          "name": "Update Customer",
          "description": "Edit customer details"
        },
        {
          "id": "apar:customer.delete",
          "name": "Delete Customer",
          "description": "Remove customers"
        }
      ]
    },
    {
      "resource": "vendor_invoice",
      "actions": [
        {
          "id": "apar:vendor_invoice.read",
          "name": "View Vendor Invoices",
          "description": "View all vendor invoices"
        },
        {
          "id": "apar:vendor_invoice.create",
          "name": "Create Vendor Invoice",
          "description": "Record vendor invoices"
        },
        {
          "id": "apar:vendor_invoice.update",
          "name": "Update Vendor Invoice",
          "description": "Edit vendor invoices"
        },
        {
          "id": "apar:vendor_invoice.delete",
          "name": "Delete Vendor Invoice",
          "description": "Remove vendor invoices"
        },
        {
          "id": "apar:vendor_invoice.approve",
          "name": "Approve Vendor Invoice",
          "description": "Approve invoices for payment"
        }
      ]
    },
    {
      "resource": "customer_invoice",
      "actions": [
        {
          "id": "apar:customer_invoice.read",
          "name": "View Customer Invoices",
          "description": "View all customer invoices"
        },
        {
          "id": "apar:customer_invoice.create",
          "name": "Create Customer Invoice",
          "description": "Issue customer invoices"
        },
        {
          "id": "apar:customer_invoice.update",
          "name": "Update Customer Invoice",
          "description": "Edit customer invoices"
        },
        {
          "id": "apar:customer_invoice.delete",
          "name": "Delete Customer Invoice",
          "description": "Remove customer invoices"
        },
        {
          "id": "apar:customer_invoice.send",
          "name": "Send Customer Invoice",
          "description": "Send invoices to customers"
        }
      ]
    },
    {
      "resource": "payment",
      "actions": [
        {
          "id": "apar:payment.read",
          "name": "View Payments",
          "description": "View all payments"
        },
        {
          "id": "apar:payment.create",
          "name": "Create Payment",
          "description": "Record payments"
        },
        {
          "id": "apar:payment.update",
          "name": "Update Payment",
          "description": "Edit payment records"
        },
        {
          "id": "apar:payment.delete",
          "name": "Delete Payment",
          "description": "Remove payment records"
        }
      ]
    },
    {
      "resource": "credit_note",
      "actions": [
        {
          "id": "apar:credit_note.read",
          "name": "View Credit Notes",
          "description": "View all credit notes"
        },
        {
          "id": "apar:credit_note.create",
          "name": "Create Credit Note",
          "description": "Issue credit notes"
        },
        {
          "id": "apar:credit_note.update",
          "name": "Update Credit Note",
          "description": "Edit credit notes"
        }
      ]
    },
    {
      "resource": "reports",
      "actions": [
        {
          "id": "apar:reports.view",
          "name": "View Reports",
          "description": "Access AP/AR analytics and aging reports"
        }
      ]
    },
    {
      "resource": "settings",
      "actions": [
        {
          "id": "apar:settings.manage",
          "name": "Manage Settings",
          "description": "Configure AP/AR payment terms and defaults"
        }
      ]
    },
    {
      "resource": "sync",
      "actions": [
        {
          "id": "apar:sync.pull",
          "name": "Sync Pull",
          "description": "Pull data from core"
        },
        {
          "id": "apar:sync.push",
          "name": "Sync Push",
          "description": "Push data to core"
        }
      ]
    }
  ],

