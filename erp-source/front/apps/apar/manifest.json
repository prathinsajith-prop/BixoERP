        {
          "name": "payment_date",
          "type": "date",
          "required": true,
          "readonly": false
        },
        {
          "name": "method",
          "type": "enum",
          "required": true,
          "readonly": false,
          "enum_values": [
            "bank_transfer",
            "cheque",
            "cash",
            "credit_card",
            "online"
          ]
        },
        {
          "name": "reference",
          "type": "string",
          "required": false,
          "readonly": false
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "readonly": false,
          "enum_values": ["pending", "processed", "failed", "reversed"]
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true,
          "readonly": true
        }
      ],
      "indexes": ["payment_number", "party_id", "status", "payment_date"]
    }
  ],

  "events": {
    "published": [
      {
        "name": "apar:vendor_invoice.created",
        "description": "Fired when a vendor invoice is created"
      },
      {
        "name": "apar:vendor_invoice.approved",
        "description": "Fired when a vendor invoice is approved"
      },
      {
        "name": "apar:customer_invoice.sent",
        "description": "Fired when a customer invoice is sent"
      },
      {
        "name": "apar:payment.processed",
        "description": "Fired when a payment is processed"
      },
      {
        "name": "apar:invoice.overdue",
        "description": "Fired when an invoice becomes overdue"
      },
      {
        "name": "apar:credit_note.issued",
        "description": "Fired when a credit note is issued"
      }
    ],
    "subscribed": [
      {
        "name": "procurement:po.approved",
        "handler": "apar:sync.create_vendor_invoice"
      },
      {
        "name": "sales:order.invoiced",
        "handler": "apar:sync.create_customer_invoice"
      },
      {
        "name": "finance:period.closed",
        "handler": "apar:sync.period_close_reconcile"
      }
    ]
  },

  "api": {
    "base_path": "/api/v1/apar",
    "auth": "bearer_token",
    "rate_limit": { "requests_per_minute": 350, "burst": 50 },
    "endpoints": [
      { "method": "GET", "path": "/vendors", "scope": "apar:vendor.read" },
      { "method": "POST", "path": "/vendors", "scope": "apar:vendor.create" },
      { "method": "GET", "path": "/vendors/:id", "scope": "apar:vendor.read" },
      {
        "method": "PUT",
        "path": "/vendors/:id",
        "scope": "apar:vendor.update"
      },
      {
        "method": "DELETE",
        "path": "/vendors/:id",
        "scope": "apar:vendor.delete"
      },
      { "method": "GET", "path": "/customers", "scope": "apar:customer.read" },
      {
        "method": "POST",
        "path": "/customers",
        "scope": "apar:customer.create"
      },
      {
        "method": "GET",
        "path": "/customers/:id",
        "scope": "apar:customer.read"
      },
      {
        "method": "PUT",
        "path": "/customers/:id",
        "scope": "apar:customer.update"
      },
      {
        "method": "GET",
        "path": "/vendor-invoices",
        "scope": "apar:vendor_invoice.read"
      },
      {
        "method": "POST",
        "path": "/vendor-invoices",
        "scope": "apar:vendor_invoice.create"
      },
      {
        "method": "GET",
        "path": "/vendor-invoices/:id",
        "scope": "apar:vendor_invoice.read"
      },
      {
        "method": "PUT",
        "path": "/vendor-invoices/:id",
        "scope": "apar:vendor_invoice.update"
      },
      {
        "method": "POST",
        "path": "/vendor-invoices/:id/approve",
        "scope": "apar:vendor_invoice.approve"
      },
      {
        "method": "GET",
        "path": "/customer-invoices",
        "scope": "apar:customer_invoice.read"
      },
      {
        "method": "POST",
        "path": "/customer-invoices",
        "scope": "apar:customer_invoice.create"
      },
      {
        "method": "PUT",
        "path": "/customer-invoices/:id",
        "scope": "apar:customer_invoice.update"
      },
      {
        "method": "POST",
        "path": "/customer-invoices/:id/send",
        "scope": "apar:customer_invoice.send"
      },
      { "method": "GET", "path": "/payments", "scope": "apar:payment.read" },
      { "method": "POST", "path": "/payments", "scope": "apar:payment.create" },
      {
        "method": "GET",
        "path": "/aging/payables",
        "scope": "apar:reports.view"
      },
      {
        "method": "GET",
        "path": "/aging/receivables",
        "scope": "apar:reports.view"
      },
      { "method": "POST", "path": "/sync/pull", "scope": "apar:sync.pull" },
      { "method": "POST", "path": "/sync/push", "scope": "apar:sync.push" }
    ]
  },

  "health_check": {
    "endpoint": "/api/v1/apar/health",
    "interval_seconds": 60,
    "timeout_seconds": 5
  },

  "logging": {
    "level": "info",
    "audit_trail": true,
    "sensitive_fields_masked": [
      "total_amount",
      "paid_amount",
      "subtotal",
      "tax_amount",
      "amount",
      "credit_limit",
      "bank_account"
    ]
  }
}
